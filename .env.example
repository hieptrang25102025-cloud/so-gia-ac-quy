# =========================================================================
# SỔ GIÁ ẮC QUY - ENVIRONMENT VARIABLES TEMPLATE (PRODUCTION / RENDER)
# =========================================================================

# 1. Cổng máy chủ (Render tự động cấp PORT, mặc định local là 3001)
PORT=3001
HOST=0.0.0.0

# 2. Google Gemini API Key (Bóc tách báo giá bằng hình ảnh - bắt buộc cho Backend)
# Đăng ký miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Supabase Configuration (Cơ sở dữ liệu, Xác thực & Lưu trữ ảnh)
# Lấy tại Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 4. (Tùy chọn) Supabase Service Role Key (Chỉ dùng cho Backend server nếu cần bypass RLS)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
